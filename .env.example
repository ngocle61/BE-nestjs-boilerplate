NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# Local PostgreSQL 18 (see database/create-database.sql)
DATABASE_URL="postgresql://nestjs_boilerplate:CHANGE_ME@localhost:5432/nestjs_boilerplate?schema=public"
# Docker alternative (docker compose up -d)
# DATABASE_URL="postgresql://nestjs_boilerplate:nestjs_boilerplate@localhost:5433/nestjs_boilerplate?schema=public"

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Optional: powers the AI Chat module (POST /chat/messages). Without a key the app still
# starts, but chat requests return a clear "ai_not_configured" error.
# Works with any OpenAI-compatible API.

# Free: Google Gemini. Get a key at https://aistudio.google.com/apikey
# OPENAI_API_KEY=AIza...
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.6-flash
OPENAI_REASONING_EFFORT=none

# Paid: OpenAI. Get a key at https://platform.openai.com/api-keys, remove
# OPENAI_BASE_URL and OPENAI_REASONING_EFFORT, and use:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
